{
  "name": "unkernelos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full Graphical Linux OS in the Browser powered by unkernel, Bun, TypeScript, Effect-TS & WebGPU",
  "scripts": {
    "dev": "bun run server/dev.ts",
    "dev:vite": "vite",
    "build": "vite build",
