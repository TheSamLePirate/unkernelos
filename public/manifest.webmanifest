{
  "name": "unkernelOS — Browser Linux Desktop & AI Studio",
  "short_name": "unkernelOS",
  "description": "Full Linux 7.x WebOS in your browser with multi-vCPU Web Workers, WebGPU Kitty Terminal, Wayland/GL, Code IDE & Claude/Pi AI Studio.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07080c",
  "theme_color": "#0b0d17",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Agent Studio",
      "short_name": "Studio",
      "url": "./?app=agent-studio",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Kitty Terminal",
      "short_name": "Terminal",
      "url": "./?app=terminal",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Code IDE",
      "short_name": "Code",
      "url": "./?app=ide",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
}
